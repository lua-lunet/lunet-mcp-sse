FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG TARGETARCH

RUN mkdir -p /app/bin /app/lib

COPY dist/${TARGETARCH}/bin/lunet /app/bin/lunet
COPY dist/${TARGETARCH}/lib/ /app/lib/

COPY app/ /app/app/
COPY run.sh /app/run.sh

ENV LUA_CPATH=/app/lib/?.so;;

RUN chmod +x /app/run.sh

EXPOSE 8080

CMD ["/app/run.sh"]
